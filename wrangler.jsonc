{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lexora",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lexora-db",
      "database_id": "c0257918-71f4-4c1c-a979-b0367239713d",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
